{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "site": "diffmd",
    "public": "deploy/firebase-public",
    "ignore": ["**/.*"],
    "rewrites": [
      {
        "source": "**",
        "run": {
          "serviceId": "diffmd-web",
          "region": "us-central1",
          "pinTag": true
        }
      }
    ]
  }
}
