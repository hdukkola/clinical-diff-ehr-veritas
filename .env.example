# Clinical Diff EHR Veritas — Environment Template (Synthetic Data Only)
# Copy to .env.local for local development or configure in your deployment environment.
# Never commit real secrets, API keys, or private tunnel URLs.

# Provider selector: auto | mlx_service | openai_compatible | ollama | deterministic_replay
CLINICAL_DIFF_MODEL_PROVIDER=auto

# Option A: Local or tunneled MLX Python service (fresh-backend/service.py)
# Example loopback: http://127.0.0.1:8765 (or set your HTTPS tunnel endpoint at deploy time)
CLINICAL_DIFF_BACKEND_URL=
CLINICAL_DIFF_LOCAL_LOOPBACK_PORT=8765
# Set to 1 to probe local loopback 127.0.0.1:8765 even when CLINICAL_DIFF_BACKEND_URL is blank
# CLINICAL_DIFF_LOCAL_LOOPBACK_ENABLED=0

# MLX model & optional LoRA/QLoRA adapter configuration (used by fresh-backend/service.py)
MLX_MODEL_ID=mlx-community/Qwen3.5-4B-4bit
MLX_MODEL_REVISION=0e7ffd5c629ef7719d4cbc04069232580bfa9d9c
MLX_ADAPTER_PATH=
CLINICAL_DIFF_HOST=127.0.0.1
CLINICAL_DIFF_PORT=8765
CLINICAL_DIFF_ALLOWED_ORIGINS=

# Option B: OpenAI-compatible inference endpoint (vLLM, LM Studio, OpenAI-compatible gateway)
OPENAI_COMPATIBLE_BASE_URL=
CLINICAL_DIFF_API_KEY=

# Option C: Ollama endpoint (local loopback or HTTPS gateway)
OLLAMA_BASE_URL=

# Shared model ID override for openai_compatible / ollama providers
CLINICAL_DIFF_MODEL_ID=
