{
  "name": "clinical-diff-ehr",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "qa:widgets": "firebase emulators:exec --config firebase.widget-qa.json --project demo-diffmd-widget-qa --only auth,firestore \"node scripts/serve-widget-qa.mjs\"",
    "qa:widgets:training": "node scripts/serve-widget-qa.mjs --training",
    "eval:model": "node tests/model-eval/run_model_eval.mjs"
  },
  "dependencies": {
    "@clerk/nextjs": "7.10.0",
    "firebase": "13.3.0",
    "firebase-admin": "14.5.1",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsdom": "^31.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.7"
  }
}
